programa teste_completo;
var n, fatorial, i: inteiro;
    encontrou: booleano;

inicio
   { Lê um número }
   leia(n);
   
   { Calcula o fatorial }
   fatorial := 1;
   i := 1;
   enquanto i <= n faca
   inicio
      fatorial := fatorial * i;
      i := i + 1
   fim;
   
   { Verifica se é maior que 100 }
   encontrou := falso;
   se fatorial > 100 entao
      encontrou := verdadeiro;
   
   { Imprime resultado }
   escreva(fatorial);
   
   se encontrou entao
      escreva(1)
   senao
      escreva(0)
fim.

